# Example Makefile for pFUnit tests (serial), for projects not using CMake.
#
# Set PFUNIT to the install prefix (the directory holding include/PFUNIT.mk
# — unlike CMake, a parent dir is not enough) and build:
#   PFUNIT=<pfunit-install> make
# or:
#   make PFUNIT=<pfunit-install>
#
# This builds:
#   test_multiply        - the simple test
#   test_multiply_param  - the parameterized test
# Run the executables directly; they report results to stdout.

FC = gfortran
FFLAGS = -Wall -Wextra -O2

# Specify pFUnit location and include its Make functions.
# PFUNIT.mk sets PFUNIT_EXTRA_FFLAGS (include paths) and the libraries.
include $(PFUNIT)/include/PFUNIT.mk
FFLAGS += $(PFUNIT_EXTRA_FFLAGS)

# Objects for the code under test. Putting them in _OTHER_SOURCES links them
# directly into each test executable, so no library/archive rules are needed.
LIB_OBJS := multiply_mod.o

all: test_multiply test_multiply_param

# ==========================================
# Simple test
# ==========================================
TARGET_TEST = test_multiply

# Extra pFUnit machinery required to parse .pf files and wire compilation:
$(TARGET_TEST)_TESTS := unittest_multiply.pf
$(TARGET_TEST)_REGISTRY :=
$(TARGET_TEST)_OTHER_SOURCES := $(LIB_OBJS)
$(TARGET_TEST)_OTHER_LIBRARIES :=
$(TARGET_TEST)_OTHER_INCS :=

$(eval $(call make_pfunit_test,$(TARGET_TEST)))

# ==========================================
# Parameterized test
# ==========================================
TARGET_TEST_PARAM = test_multiply_param

$(TARGET_TEST_PARAM)_TESTS := unittest_multiply_param.pf
$(TARGET_TEST_PARAM)_REGISTRY :=
$(TARGET_TEST_PARAM)_OTHER_SOURCES := $(LIB_OBJS)
$(TARGET_TEST_PARAM)_OTHER_LIBRARIES :=
$(TARGET_TEST_PARAM)_OTHER_INCS :=

$(eval $(call make_pfunit_test,$(TARGET_TEST_PARAM)))

# ==========================================
# Support rules
# ==========================================
# The preprocessed .F90 test files `use` the module under test, so its .mod
# must exist before they compile (PFUNIT.mk adds no such dependency itself):
unittest_multiply.o: multiply_mod.o
unittest_multiply_param.o: multiply_mod.o

%.o: %.f90
	$(FC) $(FFLAGS) -c $<

%.o: %.F90
	$(FC) $(FFLAGS) -c $<

clean:
	$(RM) *.o *.mod *.a *.inc
	$(RM) unittest_multiply.F90 unittest_multiply_param.F90

clean-all: clean
	$(RM) $(TARGET_TEST) $(TARGET_TEST_PARAM)

# For MPI builds (pFUnit installed with MPI support, i.e. libpfunit), also set
# USEMPI=YES before including PFUNIT.mk, which switches the link to -lpfunit.
